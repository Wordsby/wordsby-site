---
import { brand, brandAsset } from '../lib/brand';
import { loadDirection } from '../lib/direction';
import { settings } from '../lib/settings';

const direction = loadDirection(brand.design.direction);
// A dark header needs the light version of the logo.
const logo = direction.canvas === 'dark' && brand.logo.on_dark ? brand.logo.on_dark : brand.logo.primary;
const { header, cta } = settings.navigation;
const current = Astro.url.pathname;
const isCurrent = (href: string) => href === current || (href !== '/' && current.startsWith(href));
---

<header class:list={['site-header', `tone-${direction.canvas}`]} style={brand.logo.height ? `--logo-height: ${brand.logo.height}` : undefined}>
  <div class="container site-header__inner">
    <a class="site-header__logo" href="/">
      <img src={brandAsset(logo)} alt={`${brand.name} home`} />
    </a>
    <button class="site-header__toggle" type="button" aria-expanded="false" aria-controls="site-nav">Menu</button>
    <nav id="site-nav" class="site-header__nav" aria-label="Main">
      <ul>
        {
          header.map((link) => (
            <li>
              <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      {cta && <a class="button" href={cta.href}>{cta.label}</a>}
    </nav>
  </div>
</header>

<script>
  // Collapse the menu on small screens only when JavaScript is available to open it.
  const header = document.querySelector('.site-header');
  const toggle = header?.querySelector<HTMLButtonElement>('.site-header__toggle');
  header?.classList.add('has-js');
  toggle?.addEventListener('click', () => {
    toggle.setAttribute('aria-expanded', String(toggle.getAttribute('aria-expanded') !== 'true'));
  });
</script>

<style>
  .site-header {
    border-bottom: 1px solid var(--border);
  }
  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-4);
  }
  .site-header__logo img {
    display: block;
    height: var(--logo-height, 2.75rem);
    width: auto;
    max-width: 15rem;
    object-fit: contain;
  }
  .site-header__toggle {
    display: none;
  }
  .site-header__nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-5);
  }
  .site-header__nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .site-header__nav a:not(.button) {
    color: var(--fg);
    font-weight: 600;
    text-decoration: none;
  }
  .site-header__nav a:not(.button):hover,
  .site-header__nav a[aria-current='page'] {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }

  @media (max-width: 48rem) {
    .has-js .site-header__toggle {
      display: block;
      padding: var(--space-2) var(--space-3);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      background: none;
      color: var(--fg);
      font: inherit;
      font-weight: 600;
    }
    .has-js .site-header__nav {
      display: none;
      flex-basis: 100%;
      flex-direction: column;
      align-items: flex-start;
    }
    .has-js .site-header__toggle[aria-expanded='true'] + .site-header__nav {
      display: flex;
    }
    .site-header__nav ul {
      flex-direction: column;
      gap: var(--space-3);
    }
  }
</style>
